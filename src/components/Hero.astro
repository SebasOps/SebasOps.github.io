---
// src/components/Hero.astro
/**
 * Presentación del Inicio: saludo, nombre (h1), rol, enlaces de contacto
 * y botones de descarga del CV.
 * Props:
 *  - lang: idioma de la página.
 * Los datos de contacto salen de src/data/site.ts.
 */

import LinkButton from './LinkButton.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Enlaces de contacto; `external` abre la página en otra pestaña
const contacts = [
  { icon: 'mail', label: site.email, href: `mailto:${site.email}`, external: false },
  { icon: 'linkedin', label: 'LinkedIn', href: site.linkedin, external: true },
  { icon: 'github', label: 'GitHub', href: site.github, external: true },
] as const;
---

<section class="hero" aria-labelledby="hero-name">
  <p class="hero__greeting">{t('home.greeting')}</p>
  <h1 id="hero-name" class="hero__name">{site.name}</h1>
  <p class="hero__role">{t('home.role')}</p>

  <ul class="hero__contacts" aria-label={t('home.contact.label')}>
    {
      contacts.map(({ icon, label, href, external }) => (
        <li>
          {/* rel="noopener noreferrer" protege al abrir enlaces externos en otra pestaña */}
          <a
            href={href}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            {/* Iconos decorativos: el texto del enlace ya lo describe */}
            {icon === 'mail' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            )}
            {icon === 'linkedin' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="3" />
                <path d="M8 11v5M8 8v.01M12 16v-5m0 2.5c0-1.5 1-2.5 2.5-2.5S17 12 17 13.5V16" />
              </svg>
            )}
            {icon === 'github' && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
              </svg>
            )}
            {label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="hero__cv">
    <LinkButton href={site.cv.es} download>{t('cv.es')}</LinkButton>
    <LinkButton href={site.cv.en} variant="secondary" download>{t('cv.en')}</LinkButton>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .hero__greeting {
    margin: 0 0 -20px; /* acerca el saludo al nombre */
    font-size: 22px;
    color: var(--color-text-muted);
  }

  /* clamp(mínimo, preferido, máximo): el nombre se adapta al ancho de pantalla */
  .hero__name {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero__role {
    margin: -12px 0 0;
    max-width: 24ch; /* fuerza el corte de línea del subtítulo largo */
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    line-height: 1.3;
    color: var(--color-text-muted);
  }

  .hero__contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
    font-weight: 500;
  }

  .hero__contacts a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-text);
  }
  .hero__contacts a:hover {
    color: var(--color-accent);
  }

  .hero__cv {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
</style>
