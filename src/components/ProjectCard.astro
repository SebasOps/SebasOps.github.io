---
// src/components/ProjectCard.astro
/**
 * Tarjeta de proyecto: imagen (o marcador), título, descripción y enlace.
 * Props:
 *  - title, description: textos de la tarjeta.
 *  - href: página de detalle del proyecto.
 *  - linkLabel: texto del enlace (ej. "Ver proyecto").
 *  - image: portada opcional (se optimiza con astro:assets). Es decorativa (alt vacío)
 *    porque el título de la tarjeta ya nombra el proyecto.
 *  - placeholder: texto que se muestra mientras no hay imagen.
 *  - status: etiqueta opcional de estado (ej. "En desarrollo").
 *  - headingLevel: nivel del título (2 o 3) para no saltar niveles según la página.
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  image?: ImageMetadata;
  placeholder?: string;
  status?: string;
  headingLevel?: 2 | 3;
}

const { title, description, href, linkLabel, image, placeholder, status, headingLevel = 3 } =
  Astro.props;

// Etiqueta de título dinámica (h2 o h3)
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="card">
  <div class="card__media">
    {
      image ? (
        <Image src={image} alt="" widths={[400, 800]} sizes="(max-width: 900px) 100vw, 460px" />
      ) : (
        <span>{placeholder}</span>
      )
    }
    {status && <span class="card__status">{status}</span>}
  </div>
  <div class="card__body">
    <Heading class="card__title">{title}</Heading>
    <p class="card__text">{description}</p>
    {/* El nombre del proyecto va oculto en el enlace: "Ver proyecto" solo sería ambiguo */}
    <a class="card__link" href={href}>
      {linkLabel}<span class="sr-only"> — {title}</span> <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  /* Zona de imagen: altura fija, la captura se recorta para llenarla */
  .card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 180px;
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    font-size: 14px;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Etiqueta de estado, esquina superior derecha */
  .card__status {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 5px 12px;
    border: 1px solid var(--color-warning-border);
    border-radius: var(--radius-pill);
    background: var(--color-warning-bg);
    color: var(--color-warning-text);
    font-size: 12px;
    font-weight: 600;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
  }
  .card__title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }
  .card__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .card__link {
    margin-top: 6px;
    font-size: 15px;
    font-weight: 600;
  }
</style>
