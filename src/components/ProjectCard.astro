---
// src/components/ProjectCard.astro
/**
 * Tarjeta de proyecto: imagen (o marcador), título, descripción y enlace.
 * Props:
 *  - title, description: textos de la tarjeta.
 *  - href: página de detalle del proyecto.
 *  - linkLabel: texto del enlace (ej. "Ver proyecto").
 *  - image / imageAlt: captura opcional (se optimiza con astro:assets).
 *  - placeholder: texto que se muestra mientras no hay imagen.
 *  - status: etiqueta opcional de estado (ej. "En desarrollo").
 */

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  image?: ImageMetadata;
  imageAlt?: string;
  placeholder?: string;
  status?: string;
}

const { title, description, href, linkLabel, image, imageAlt = '', placeholder, status } =
  Astro.props;
---

<article class="card">
  <div class="card__media">
    {image ? <Image src={image} alt={imageAlt} /> : <span>{placeholder}</span>}
    {status && <span class="card__status">{status}</span>}
  </div>
  <div class="card__body">
    <h3 class="card__title">{title}</h3>
    <p class="card__text">{description}</p>
    <a class="card__link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  /* Zona de imagen: altura fija, la captura se recorta para llenarla */
  .card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 180px;
    background: var(--color-surface-alt);
    color: var(--color-text-muted);
    font-size: 14px;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Etiqueta de estado, esquina superior derecha (color de aviso propio) */
  .card__status {
    position: absolute;
    top: 14px;
    right: 14px;
    padding: 5px 12px;
    border: 1px solid #e8c766;
    border-radius: var(--radius-pill);
    background: #fff4d6;
    color: #6b4a00;
    font-size: 12px;
    font-weight: 600;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 22px 22px;
  }
  .card__title {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }
  .card__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .card__link {
    margin-top: 6px;
    font-size: 15px;
    font-weight: 600;
  }
</style>
