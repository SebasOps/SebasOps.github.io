---
// src/components/ProjectsPreview.astro
/**
 * Columna de proyectos del Inicio: tarjetas de src/data/projects.ts más una
 * tarjeta reservada para el próximo proyecto (de datos).
 * Props:
 *  - lang: idioma de la página.
 */
 
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
import { useTranslations, localizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Mientras no existan las páginas de detalle, todas las tarjetas llevan al listado
const projectsHref = localizedPath(lang, 'projects');
---

<section class="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="projects__title">{t('nav.projects')}</h2>

  {
    projects.map((project) => (
      <ProjectCard
        title={t(project.titleKey)}
        description={t(project.descriptionKey)}
        href={projectsHref}
        linkLabel={t('projects.view')}
        placeholder={project.placeholder}
        status={project.inDevelopment ? t('projects.inDev') : undefined}
      />
    ))
  }

  {/* Espacio reservado para el futuro proyecto de datos */}
  <article class="soon">
    <h3 class="soon__title">{t('projects.next.title')}</h3>
    <p class="soon__text">{t('projects.next.description')}</p>
  </article>
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .projects__title {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  /* Borde punteado: indica visualmente que es un espacio reservado */
  .soon {
    padding: 22px;
    border: 1.5px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
  }
  .soon__title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 700;
  }
  .soon__text {
    margin: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-text-muted);
  }
</style>
