---
// src/components/ProjectsPreview.astro
/**
 * Columna de proyectos del Inicio: una tarjeta por proyecto (src/data/projects.ts)
 * más la tarjeta reservada para el próximo proyecto.
 * Props:
 *  - lang: idioma de la página.
 */

import ProjectCard from './ProjectCard.astro';
import SoonCard from './SoonCard.astro';
import { projects } from '../data/projects';
import { useTranslations, localize, localizedPath, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="projects" aria-labelledby="projects-title">
  <h2 id="projects-title" class="projects__title">{t('nav.projects')}</h2>

  {
    projects.map((project) => (
      <ProjectCard
        title={localize(lang, project.name)}
        description={localize(lang, project.summary)}
        href={localizedPath(lang, `projects/${project.slug}`)}
        linkLabel={t('projects.view')}
        image={project.cover}
        status={project.inDevelopment ? t('projects.inDev') : undefined}
      />
    ))
  }

  <SoonCard lang={lang} />
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .projects__title {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
</style>
