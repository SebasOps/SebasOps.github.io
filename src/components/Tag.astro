---
// src/components/Tag.astro
/**
 * Etiqueta redondeada para una habilidad o tecnología.
 * Props:
 *  - learning: si es true, el borde es punteado (algo que se está aprendiendo).
 */

interface Props {
  learning?: boolean;
}

const { learning = false } = Astro.props;
---

<span class:list={['tag', { 'tag--learning': learning }]}><slot /></span>

<style>
  .tag {
    display: inline-block;
    padding: 8px 16px;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font-size: 14px;
    font-weight: 500;
  }

  /* Punteado: distingue lo que está en aprendizaje */
  .tag--learning {
    border-style: dashed;
    color: var(--color-text-muted);
  }
</style>
