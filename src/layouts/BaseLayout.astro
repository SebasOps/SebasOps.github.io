---
// src/layouts/BaseLayout.astro
/**
 * Layout base de todas las páginas: <html>, <head> (metadatos) y <body>.
 * Props:
 *  - lang: idioma de la página ('es' | 'en'), se usa en <html lang>.
 *  - title: título de la pestaña (y base del SEO).
 *  - description: meta descripción (opcional).
 */

import { Font } from 'astro:assets';
import '../styles/global.css'; // Astro empaqueta y enlaza el CSS global
import Navigation from '../components/Navigation.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Registra la fuente configurada en astro.config.mjs (variable --font-inter) */}
    <Font cssVariable="--font-inter" />
    <title>{title}</title>
    {/* La descripción es opcional: solo se emite la etiqueta si existe */}
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <Navigation lang={lang} />
    {/* <main> marca la zona principal para lectores de pantalla y buscadores */}
    <main>
      <slot />
    </main>
  </body>
</html>