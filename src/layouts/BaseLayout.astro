---
// src/layouts/BaseLayout.astro
/**
 * Layout base de todas las páginas: <html>, <head> (metadatos) y <body>.
 * Props:
 *  - lang: idioma de la página ('es' | 'en'), se usa en <html lang>.
 *  - title: título de la pestaña (y base del SEO).
 *  - description: meta descripción única de la página.
 *  - image: imagen para compartir en redes (opcional).
 *  - noindex: true evita la indexación (p. ej. la página 404).
 *  - showNav: false oculta la navegación (p. ej. la página 404).
 *  - rails: true muestra los carruseles de iconos a ambos lados.
 */
 
import { Font } from 'astro:assets';
import '../styles/global.css'; // Astro empaqueta y enlaza el CSS global
import Navigation from '../components/Navigation.astro';
import SeoHead from '../components/SeoHead.astro';
import SkillRail from '../components/SkillRail.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  showNav?: boolean;
  rails?: boolean;
}

const {
  lang,
  title,
  description,
  image,
  noindex = false,
  showNav = true,
  rails = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Registra la fuente configurada en astro.config.mjs (variable --font-inter) */}
    <Font cssVariable="--font-inter" preload />
    <title>{title}</title>
    {/* Descripción, canonical, hreflang y Open Graph */}
    <SeoHead lang={lang} title={title} description={description} image={image} noindex={noindex} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Ayuda a los buscadores a encontrar el sitemap generado en el build */}
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    {/* Estructura: [carril] [columna central] [carril]. Sin rails, solo la columna. */}
    <div class:list={['shell', { 'shell--rails': rails }]}>
      {
        rails && (
          <div class="shell__rail">
            <SkillRail />
          </div>
        )
      }

      <div class="shell__col">
        {showNav && <Navigation lang={lang} />}
        {/* <main> marca la zona principal para lectores de pantalla y buscadores */}
        <main>
          <slot />
        </main>
      </div>

      {
        rails && (
          <div class="shell__rail">
            {/* reverse y otra duración: los dos carriles no van sincronizados */}
            <SkillRail reverse duration={42} />
          </div>
        )
      }
    </div>
  </body>
</html>

<style>
  /* Variables del contenedor: las lee también SkillRail (--rail-width) */
  .shell {
    --rail-width: 80px; /* ancho de cada carril */
    --rail-gap: 24px; /* margen mínimo entre un carril y el contenido */
    --shell-edge: clamp(12px, 1.5vw, 24px); /* distancia de los carriles al borde de la ventana */

    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 28px var(--shell-edge);
  }

  /* Sin carriles: una sola columna centrada con ancho máximo.
     min-width: 0 permite que se encoja en lugar de desbordar. */
  .shell__col {
    flex: 1 1 0;
    min-width: 0;
    max-width: var(--container-max);
  }

  /* Con carriles: space-between los lleva a los bordes de la ventana y deja
     la columna al centro. El contenido ocupa el 50% del espacio sobrante entre
     carriles (el otro 50% queda como margen a cada lado):
       ancho = (contenedor_max + disponible) / 2
       disponible = ancho total - los dos carriles
     El tope (min) conserva siempre al menos --rail-gap junto a cada carril. */
  .shell--rails {
    justify-content: space-between;
  }
  .shell--rails .shell__col {
    flex: 0 1 auto;
    max-width: none;
    width: min(
      calc(100% - 2 * var(--rail-width) - 2 * var(--rail-gap)),
      calc((var(--container-max) + 100% - 2 * var(--rail-width)) / 2)
    );
  }

  /* sticky: los carriles se quedan a la vista al hacer scroll.
     --rail-height lo lee SkillRail; el tope de 800px mantiene el bucle sin huecos. */
  .shell__rail {
    position: sticky;
    top: 28px;
    flex: none;
    --rail-height: min(800px, calc(100vh - 56px));
  }

  /* Pantallas angostas: se ocultan los carriles (son decorativos) y la columna
     vuelve a ocupar todo el ancho. */
  @media (max-width: 900px) {
    .shell__rail {
      display: none;
    }
    .shell--rails {
      justify-content: center;
    }
    .shell--rails .shell__col {
      flex: 1 1 0;
      width: auto;
    }
  }
</style>
