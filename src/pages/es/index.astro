---
// src/pages/es/index.astro
/**
 * Página de inicio en español (/es/).
 * Compone el contenido compartido (HomeContent) dentro del layout,
 * con los carruseles de iconos a los lados.
 */
 
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeContent from '../../components/HomeContent.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('home.title')} | ${t('meta.siteName')}`}
  description={t('meta.description.home')}
  rails
>
  <HomeContent lang={lang} />
</BaseLayout>
