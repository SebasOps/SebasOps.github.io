---
// src/pages/es/index.astro
/**
 * Página de inicio en español (/es/).
 * Usa el layout base y los textos del diccionario i18n.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={`${t('home.title')} | ${t('meta.siteName')}`}>
  <h1>{t('home.title')} (ES)</h1>
</BaseLayout>
