---
// src/pages/es/projects/index.astro
/**
 * Listado de proyectos en español (/es/projects/).
 * Compone el contenido compartido (ProjectsList) dentro del layout.
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectsList from '../../../components/ProjectsList.astro';
import { useTranslations } from '../../../i18n/utils';

const lang = 'es';
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  title={`${t('nav.projects')} | ${t('meta.siteName')}`}
  description={t('meta.description.projects')}
>
  <ProjectsList lang={lang} />
</BaseLayout>
