---
// src/pages/index.astro
/**
 * Raíz del sitio (/): elige el idioma según el navegador y redirige a /es/ o /en/.
 * - Con JavaScript: toma el primer idioma preferido del navegador que el sitio soporta.
 * - Sin JavaScript: <meta refresh> dentro de <noscript> hacia el idioma por defecto.
 * - Página noindex y fuera del sitemap: solo sirve de puerta de entrada.
 * Requiere `redirectToDefaultLocale: false` en astro.config.mjs.
 */
 
import { languages, defaultLang } from '../i18n/ui';

const locales = Object.keys(languages); // ['es', 'en']
---

<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sebastián Aguilar</title>

    {/* Respaldo sin JavaScript; dentro de <noscript> para no competir con el script */}
    <noscript><meta http-equiv="refresh" content={`0;url=/${defaultLang}/`} /></noscript>

    {/* define:vars inyecta locales y defaultLang como variables del script (queda inline) */}
    <script define:vars={{ locales, defaultLang }}>
      // Idiomas del navegador, del preferido al menos preferido
      const preferred = navigator.languages && navigator.languages.length
        ? navigator.languages
        : [navigator.language];

      // Primer idioma preferido que el sitio soporta; compara solo el idioma ("en-US" -> "en")
      const match = preferred
        .map((tag) => String(tag).toLowerCase().split('-')[0])
        .find((code) => locales.includes(code));

      // replace(): la raíz no queda en el historial y "Atrás" no vuelve a redirigir
      window.location.replace('/' + (match ?? defaultLang) + '/');
    </script>
  </head>
  <body>
    {/* Respaldo visible si ninguna redirección se aplica */}
    <p><a href="/es/">Español</a> · <a href="/en/">English</a></p>
  </body>
</html>
